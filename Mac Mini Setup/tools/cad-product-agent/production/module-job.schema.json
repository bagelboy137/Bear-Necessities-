{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bear Necessities Module Production Job",
  "type": "object",
  "required": ["schema_version", "module_id", "status", "geometry_source", "frame", "components", "validators", "release_gates"],
  "properties": {
    "schema_version": {"const": 1},
    "module_id": {"type": "string", "pattern": "^BN-M(0[1-9]|10)$"},
    "status": {"enum": ["PROTOTYPE_READY", "BLOCKED_SOURCING", "BLOCKED_ENGINEERING", "AWAITING_HUMAN_REVIEW", "RELEASED"]},
    "geometry_source": {"type": "string"},
    "frame": {
      "type": "object",
      "required": ["outside_in", "inner_clear_in", "cut_list"],
      "properties": {
        "outside_in": {"const": [24.0, 20.0, 18.0]},
        "inner_clear_in": {"const": [22.0, 18.0, 16.0]},
        "cut_list": {"type": "array", "minItems": 2, "maxItems": 2}
      }
    },
    "components": {"type": "array", "minItems": 1},
    "validators": {
      "type": "object",
      "required": ["geometry", "clearance", "bom_reconciliation", "human_review"]
    },
    "release_gates": {"type": "array", "minItems": 1}
  }
}
